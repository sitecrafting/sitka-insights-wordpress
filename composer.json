{
  "name": "sitecrafting/sitka-insights-wordpress",
  "description": "Integrate your WordPress site with the Sitka Insights platform",
  "type": "wordpress-plugin",
  "repositories": {
    "wpackagist": {
      "type": "composer",
      "url": "https://wpackagist.org"
    }
  },
  "require": {
    "php": ">=7.3",
    "sitecrafting/gearlab-tools-php": "^3.0"
  },
  "require-dev": {
    "composer/installers": "^2.3",
    "johnpbloch/wordpress-core-installer": "^2.0",
    "johnpbloch/wordpress-core": "^6.5.1",
    "mnsami/composer-custom-directory-installer": "^2.0",
    "wpackagist-plugin/classic-editor": "*",
    "phpunit/phpunit": "^8.5"
  },
  "extra": {
    "installer-paths": {
      "wp/wp-content/mu-plugins/{$name}": [
        "type:wordpress-muplugin"
      ],
      "wp/wp-content/plugins/{$name}": [
        "type:wordpress-plugin"
      ]
    },
    "wordpress-install-dir": {
      "johnpbloch/wordpress-core": "wp"
    }
  },
  "dist": {
    "type": "zip",
    "url": "https://github.com/sitecrafting/sitka-insights-wordpress/releases/download/v0.0.17b/sitka-insights-0.0.17b.zip"
  },
  "archive": {
    "exclude": [
      "/test/",
      "/releases/",
      ".gitignore",
      "bin/",
      "/.github/"
    ]
  },
  "license": "MIT",
  "authors": [
    {
      "name": "Coby Tamayo",
      "email": "ctamayo@sitecrafting.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Sitka\\Plugin\\": "src/",
      "Sitka\\WpCli\\": "cli/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Sitka\\Plugin\\": "test/cases/"
    }
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "johnpbloch/wordpress-core-installer": true,
      "mnsami/composer-custom-directory-installer": true
    }
  }
}
